  _questionText: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u043E\u0442 \u0432\u0438\u0440\u0443\u0441\u043E\u0432?"
  _answerArray:
  - _answerText: "\u0412\u0435\u0431-\u0431\u0440\u0430\u0443\u0437\u0435\u0440"
    _isCorrect: 0
  - _answerText: "\u0410\u043D\u0442\u0438\u0432\u0438\u0440\u0443\u0441"
    _isCorrect: 1
  - _answerText: "\u041E\u0444\u0438\u0441\u043D\u044B\u0439 \u043F\u0430\u043A\u0435\u0442 "
    _isCorrect: 0
  - _answerText: "\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
