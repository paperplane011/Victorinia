  _questionDifficulty: 0
  _tag: Inf
  _questionText: "\u041A\u0430\u043A\u043E\u0439 \u0438\u0437 \u044D\u0442\u0438\u0445
    \u0442\u0435\u0440\u043C\u0438\u043D\u043E\u0432 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043E\u0447\u0438\u0449\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
    \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F?"
  _answerArray:
  - _answerText: "\u0416\u0435\u0441\u0442\u043A\u0438\u0439 \u0434\u0438\u0441\u043A"
    _isCorrect: 0
  - _answerText: "\u041E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F
      \u043F\u0430\u043C\u044F\u0442\u044C"
    _isCorrect: 1
  - _answerText: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F \u043F\u0430\u043C\u044F\u0442\u044C"
    _isCorrect: 0
  - _answerText: "\u041A\u044D\u0448-\u043F\u0430\u043C\u044F\u0442\u044C"
    _isCorrect: 0
  - _answerText: "\u0421\u0435\u0442\u0435\u0432\u043E\u0439 \u0434\u0438\u0441\u043A"
    _isCorrect: 0
