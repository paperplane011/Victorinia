  _questionDifficulty: 1
  _tag: Inf
  _questionText: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \"\u0411\u0443\u043B\u0435\u0432\u0430
    \u0430\u043B\u0433\u0435\u0431\u0440\u0430\"?"
  _answerArray:
  - _answerText: "\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0442\u0435\u043E\u0440\u0438\u044F \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B
      \u0441 \u0432\u0435\u043A\u0442\u043E\u0440\u0430\u043C\u0438"
    _isCorrect: 0
  - _answerText: "\u0422\u0435\u043E\u0440\u0438\u044F \u0447\u0438\u0441\u0435\u043B"
    _isCorrect: 0
  - _answerText: "\u041C\u043E\u0434\u0435\u043B\u044C \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B
      \u0441 \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F\u043C\u0438"
    _isCorrect: 1
  - _answerText: "\u0422\u0435\u043E\u0440\u0438\u044F \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0435\u0439"
    _isCorrect: 0
  - _answerText: "\u0422\u0435\u043E\u0440\u0438\u044F \u0433\u0440\u0430\u0444\u043E\u0432"
    _isCorrect: 0
