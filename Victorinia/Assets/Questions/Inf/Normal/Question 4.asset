  m_Script: {fileID: 11500000, guid: e9ed965a40ca90c4aa805b264c4c2eb4, type: 3}
  m_Name: Question 4
  m_EditorClassIdentifier: 
  _questionDifficulty: 1
  _tag: Inf
  _questionText: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \"\u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F\"
    \u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438?"
  _answerArray:
  - _answerText: "\u041D\u0435\u0438\u0437\u043C\u0435\u043D\u044F\u0435\u043C\u044B\u0439
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0434\u0430\u043D\u043D\u044B\u0445"
    _isCorrect: 0
  - _answerText: "\u042F\u0447\u0435\u0439\u043A\u0430 \u043F\u0430\u043C\u044F\u0442\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0438\u0437\u043C\u0435\u043D\u044F\u0435\u043C\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435"
    _isCorrect: 1
  - _answerText: "\u041E\u043F\u0435\u0440\u0430\u0446\u0438\u044F \u0434\u043B\u044F
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439"
    _isCorrect: 0
  - _answerText: "\u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0430"
    _isCorrect: 0
  - _answerText: "\u0421\u043F\u043E\u0441\u043E\u0431 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
      \u0434\u0430\u043D\u043D\u044B\u0445"
    _isCorrect: 0
