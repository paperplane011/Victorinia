  _tag: Geography
  _questionText: "\u041A\u0430\u043A\u043E\u0439 \u043F\u0440\u043E\u043B\u0438\u0432
    \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442 \u0420\u043E\u0441\u0441\u0438\u044E
    \u0438 \u0421\u0428\u0410?"
  _answerArray:
  - _answerText: "\u0413\u0438\u0431\u0440\u0430\u043B\u0442\u0430\u0440\u0441\u043A\u0438\u0439
      \u043F\u0440\u043E\u043B\u0438\u0432"
    _isCorrect: 0
  - _answerText: "\u0411\u0435\u0440\u0438\u043D\u0433\u043E\u0432 \u043F\u0440\u043E\u043B\u0438\u0432"
    _isCorrect: 1
  - _answerText: "\u041F\u0440\u043E\u043B\u0438\u0432 \u041B\u0430-\u041C\u0430\u043D\u0448"
    _isCorrect: 0
  - _answerText: "\u041F\u0440\u043E\u043B\u0438\u0432 \u0414\u0440\u0435\u0439\u043A\u0430"
    _isCorrect: 0
  - _answerText: "\u041C\u043E\u0437\u0430\u043C\u0431\u043A\u0441\u043A\u0438\u0439
      \u043F\u0440\u043E\u043B\u0438\u0432"
    _isCorrect: 0
