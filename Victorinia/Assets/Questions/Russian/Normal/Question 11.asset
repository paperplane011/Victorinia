  _tag: Russian
  _questionText: "\u041A\u0430\u043A\u043E\u0435 \u0438\u0437 \u044D\u0442\u0438\u0445
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C?"
  _answerArray:
  - _answerText: "\u041F\u043E\u0448\u0435\u043B \u043B\u0438 \u0434\u043E\u0436\u0434\u044C?"
    _isCorrect: 0
  - _answerText: "\u041F\u043E\u0448\u0435\u043B\u044C \u0434\u043E\u0436\u0434\u044C."
    _isCorrect: 1
  - _answerText: "\u041A\u0430\u043A \u043F\u043E\u0448\u0435\u043B \u0434\u043E\u0436\u0434\u044C!"
    _isCorrect: 0
  - _answerText: "\u041A\u0430\u043A \u043F\u043E\u0448\u0435\u043B \u0434\u043E\u0436\u0434\u044C."
