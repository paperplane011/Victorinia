  m_Script: {fileID: 11500000, guid: e9ed965a40ca90c4aa805b264c4c2eb4, type: 3}
  m_Name: Question 9
  m_EditorClassIdentifier: 
  _questionDifficulty: 0
  _tag: Russian
  _questionText: "\u041A\u0430\u043A\u043E\u0435 \u0438\u0437 \u044D\u0442\u0438\u0445
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C?"
  _answerArray:
  - _answerText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E."
    _isCorrect: 0
  - _answerText: "\u0417\u0430\u0432\u0442\u0440\u0430 \u0431\u0443\u0434\u0435\u0442
      \u0434\u043E\u0436\u0434\u044C."
    _isCorrect: 0
  - _answerText: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0438\u0434\u0435\u0442 \u0434\u043E\u0436\u0434\u044C?"
    _isCorrect: 1
  - _answerText: "\u041C\u044B \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434 \u043A\u0440\u044B\u0448\u0435\u0439."
    _isCorrect: 0
  - _answerText: "\u0414\u043E\u0436\u0434\u044C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F."
    _isCorrect: 0
