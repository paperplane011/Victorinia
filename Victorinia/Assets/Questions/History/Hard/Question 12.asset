  _questionDifficulty: 2
  _tag: History
  _questionText: "\u041A\u0430\u043A\u043E\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u0435
    \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0432 1703 \u0433\u043E\u0434\u0443
    \u0438 \u0441\u0442\u0430\u043B\u043E \u0437\u043D\u0430\u0447\u0438\u043C\u044B\u043C
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0420\u043E\u0441\u0441\u0438\u0438?"
  _answerArray:
  - _answerText: "\u041F\u043E\u0431\u0435\u0434\u0430 \u0432 \u041A\u0443\u043B\u0438\u043A\u043E\u0432\u0441\u043A\u043E\u0439
      \u0431\u0438\u0442\u0432\u0435"
    _isCorrect: 0
  - _answerText: "\u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0430"
    _isCorrect: 1
  - _answerText: "\u041E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 \u0421\u043C\u0443\u0442\u043D\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
    _isCorrect: 0
  - _answerText: "\u041D\u0430\u0447\u0430\u043B\u043E \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u044B II"
    _isCorrect: 0
  - _answerText: "\u041E\u0442\u043C\u0435\u043D\u0430 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u043D\u043E\u0433\u043E
      \u043F\u0440\u0430\u0432\u0430"
    _isCorrect: 0
