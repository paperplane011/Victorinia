  _answerArray:
  - _answerText: "\u041A\u0443\u043B\u0438\u043A\u043E\u0432\u0441\u043A\u0430\u044F
      \u0431\u0438\u0442\u0432\u0430"
    _isCorrect: 0
  - _answerText: "\u041A\u0440\u0435\u0449\u0435\u043D\u0438\u0435 \u0420\u0443\u0441\u0438"
    _isCorrect: 1
  - _answerText: "\u0411\u0438\u0442\u0432\u0430 \u043D\u0430 \u041D\u0435\u0432\u0435"
    _isCorrect: 0
  - _answerText: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u0435 \u0434\u0435\u043A\u0430\u0431\u0440\u0438\u0441\u0442\u043E\u0432"
    _isCorrect: 0
  - _answerText: "\u041D\u0430\u0447\u0430\u043B\u043E \u0421\u043C\u0443\u0442\u043D\u043E\u0433\u043E
