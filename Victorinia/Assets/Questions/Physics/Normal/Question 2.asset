  _questionText: "\u041A\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u0440\u043E\u043C \u0437\u0430\u043A\u043E\u043D\u0430
