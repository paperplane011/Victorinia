  _answerArray:
  - _answerText: "\u0410\u043B\u044C\u0431\u0435\u0440\u0442 \u042D\u0439\u043D\u0448\u0442\u0435\u0439\u043D"
    _isCorrect: 0
  - _answerText: "\u0418\u0441\u0430\u0430\u043A \u041D\u044C\u044E\u0442\u043E\u043D"
    _isCorrect: 1
  - _answerText: "\u0413\u0430\u043B\u0438\u043B\u0435\u043E \u0413\u0430\u043B\u0438\u043B\u0435\u0439"
