  _questionText: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u043C\u043E\u043B\u043D\u0438\u044F?"
  _answerArray:
  - _answerText: "\u042D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0440\u0430\u0437\u0440\u044F\u0434 \u0432 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0435?"
    _isCorrect: 1
  - _answerText: "\u0423\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439
      \u0441\u0432\u0435\u0442"
    _isCorrect: 0
  - _answerText: "\u041F\u043E\u0442\u043E\u043A \u0432\u043E\u0437\u0434\u0443\u0445\u0430"
    _isCorrect: 0
  - _answerText: "\u0417\u0432\u0443\u043A\u043E\u0432\u0430\u044F \u0432\u043E\u043B\u043D\u0430"
    _isCorrect: 0
  - _answerText: "\u0412\u043E\u0434\u044F\u043D\u043E\u0439 \u043F\u0430\u0440"
    _isCorrect: 0
